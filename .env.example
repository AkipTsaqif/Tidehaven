# Copy to .env and fill in. Never commit .env — it holds a real API key.

# OpenAI-compatible API root. Usually ends in /v1. A local endpoint may be http://127.0.0.1:11434/v1
TIDEHAVEN_API_BASE_URL=
# Bearer token. Leave empty for a local endpoint that needs no authentication.
TIDEHAVEN_API_KEY=
# Model identifier known to that endpoint.
TIDEHAVEN_MODEL=

# Optional overrides
# Founding scenario, read from scenarios/<name>.json when a NEW town is created (default tidehaven).
# "eden" starts with only Adam and Eve. Use a separate TIDEHAVEN_DATA_DIR per scenario.
# TIDEHAVEN_SCENARIO=eden
# Town name shown on the dashboard, used only when the town is founded.
# TIDEHAVEN_WORLD_NAME=Eden
# TIDEHAVEN_DATA_DIR=D:/Projects/Tidehaven/data
# TIDEHAVEN_PORT=4317
# TIDEHAVEN_POPULATION_TARGET=120
# TIDEHAVEN_POPULATION_POLICY=soft_target|disabled   # founding only; saved towns keep their stored policy
# TIDEHAVEN_HOST_CEILING=500                    # integer 1..1000000
# TIDEHAVEN_CONCURRENCY=8
# TIDEHAVEN_DRAMA=calm|dramatic|volatile
# TIDEHAVEN_DAILY_TOKEN_CEILING=           # empty = no spending ceiling
# TIDEHAVEN_MONTHLY_TOKEN_CEILING=
# TIDEHAVEN_DAILY_REQUEST_CEILING=
# TIDEHAVEN_LOG_LEVEL=info
# Output token allowance per request (default 800). Reasoning models need more (e.g. 4000),
# otherwise they spend it all thinking and return empty content.
# TIDEHAVEN_MAX_OUTPUT_TOKENS=800
# Minimum free space on the data volume before the runner pauses (MiB, default 5120)
# TIDEHAVEN_MIN_FREE_MB=5120
# Minimum detail retention is configured in config/defaults.json (retention, backups, budget).
